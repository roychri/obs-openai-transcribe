# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!/tools
!PLAN_OPENAI_FORK.md
!.clang-format
!.cmake-format.json
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md
!conanfile.txt
!conanfile_win.txt

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude Python bytecode from tools/
__pycache__/
*.pyc

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# protobuf generated files
*.pb.cc
*.pb.h
